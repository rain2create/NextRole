# Qwen application API key (usage-based). Do not use a Token Plan client key.
QWEN_API_KEY=
QWEN_MODEL=qwen3.7-plus
# Optional override; the browser agent needs both image inputs and tool calling.
# QWEN_AGENT_MODEL=qwen3.7-plus
# Enable separately once the model connection has been verified.
QWEN_WEB_SEARCH=false

# Browser the agent drives: chrome (installed Google Chrome, default), msedge, or chromium (Playwright's bundled build).
# BROWSER_CHANNEL=chrome
# Set to true to hide the agent's browser window (you then can't sign in or solve CAPTCHAs when it pauses).
# HEADLESS=false
# Safety caps per application: model steps, and input tokens (the run stops and leaves the tab open).
# AGENT_MAX_STEPS=40
# AGENT_MAX_RUN_TOKENS=150000

# Optional server-side credentials for manual job discovery, one page per direction.
# APISH_KEY=
